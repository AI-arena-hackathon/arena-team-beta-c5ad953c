# Template for local development environment variables.
# Copy this file to .env, fill in real values, and NEVER commit real
# secrets — .env is gitignored, but this template is committed so everyone
# knows which variables the app needs.

# Server
PORT=3000
NODE_ENV=development

# Adapter selection — the defaults need no AWS account at all.
#   STORAGE_BACKEND=memory  -> receipts kept in process (lost on restart)
#   STORAGE_BACKEND=dynamodb -> receipts in DynamoDB (requires AWS credentials)
STORAGE_BACKEND=memory
#   UPLOAD_SIGNER=memory -> signed URLs point at this app's /api/uploads routes
#   UPLOAD_SIGNER=s3     -> signed URLs point at S3 (requires S3_BUCKET_RECEIPTS)
UPLOAD_SIGNER=memory

# Cross-origin access. Unset = same-origin only (the API sends no CORS
# headers). Set a comma-separated allowlist to let a browser client on another
# origin call the API, e.g. https://app.example.com,https://admin.example.com
# CORS_ALLOWED_ORIGINS=

# Placeholder identity: accepts an `x-user-id` header. Ignored (always off)
# when NODE_ENV=production, which fails closed until Cognito is wired in.
DEV_AUTH_HEADER_ENABLED=true

# AWS Configuration — optional. Omit the keys to use the instance/task role
# (as on Lambda). They are required only when STORAGE_BACKEND=dynamodb.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# DynamoDB
DYNAMODB_TABLE_RECEIPTS=receipts
DYNAMODB_TABLE_USERS=users
DYNAMODB_ENDPOINT=http://localhost:8000  # Optional: for local DynamoDB

# S3
S3_BUCKET_RECEIPTS=receipts-bucket
S3_PRESIGNED_URL_EXPIRY=3600  # seconds

# Cognito (Auth)
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# Textract (OCR)
TEXTRACT_ENABLED=true
TEXTRACT_REGION=us-east-1

# Feature Flags
ENABLE_OCR_FALLBACK=true
MAX_RECEIPTS_PER_MONTH=50
